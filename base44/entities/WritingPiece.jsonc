{
  "name": "WritingPiece",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "form": {
      "type": "string",
      "enum": [
        "poem",
        "essay",
        "story",
        "notes"
      ],
      "default": "poem"
    },
    "stage": {
      "type": "string",
      "enum": [
        "seedling",
        "growing",
        "bloom",
        "resting"
      ],
      "default": "seedling"
    },
    "exposure": {
      "type": "string",
      "enum": [
        "private",
        "inner_circle",
        "open_studio",
        "published"
      ],
      "default": "private"
    },
    "excerpt": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "word_count": {
      "type": "number",
      "default": 0
    },
    "last_tended": {
      "type": "string",
      "format": "date-time"
    },
    "archived": {
      "type": "boolean",
      "default": false
    },
    "archived_date": {
      "type": "string",
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "created": {
            "type": "string"
          }
        }
      }
    },
    "self_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "created": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "title"
  ]
}