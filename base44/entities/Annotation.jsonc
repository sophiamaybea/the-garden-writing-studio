{
  "name": "Annotation",
  "type": "object",
  "properties": {
    "piece_id": {
      "type": "string"
    },
    "line_index": {
      "type": "number"
    },
    "line_text": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "dismissed"
      ],
      "default": "open"
    }
  },
  "required": [
    "piece_id",
    "line_index",
    "note",
    "author_id"
  ]
}