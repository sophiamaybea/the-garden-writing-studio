{
  "name": "GallerySubmission",
  "type": "object",
  "properties": {
    "piece_id": {
      "type": "string"
    },
    "piece_title": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "offered",
        "under_review",
        "accepted",
        "published",
        "returned"
      ],
      "default": "offered"
    },
    "editor_note": {
      "type": "string"
    }
  },
  "required": [
    "piece_id",
    "author_id"
  ]
}