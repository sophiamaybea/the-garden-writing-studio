{
  "name": "WorkshopRoom",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date-time"
    },
    "time_label": {
      "type": "string"
    },
