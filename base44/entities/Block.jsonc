{
  "name": "Block",
  "type": "object",
  "properties": {
    "board_id": {
      "type": "string"
    },
    "block_type": {
      "type": "string",
      "enum": [
        "image",
        "quote",
        "link",
        "text",
        "music"
      ],
      "default": "text"
    },
    "content": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "caption": {
      "type": "string"
    },
    "source_label": {
      "type": "string"
    }
  },
  "required": [
    "board_id",
    "block_type"
  ]
}