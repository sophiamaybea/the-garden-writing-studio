{
  "name": "FriendRequest",
  "type": "object",
  "properties": {
    "from_id": {
      "type": "string"
    },
    "from_name": {
      "type": "string"
    },
    "to_id": {
      "type": "string"
    },
    "to_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "declined"
      ],
      "default": "pending"
    }
  },
  "required": [
    "from_id",
    "to_id"
  ]
}